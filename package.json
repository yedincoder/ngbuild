    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-refresh": "^0.18.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
