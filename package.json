{
  "name": "ngbuild",
  "version": "0.3.0",
  "description": "Modern frontend development and build tool",
  "type": "module",
  "bin": {
    "ngbuild": "./bin/ngbuild.js"
  },
  "scripts": {
    "dev": "npm run compile && node bin/ngbuild.js dev",
    "compile": "tsc",
    "build": "tsc",
    "playground": "npm run compile && node bin/ngbuild.js dev playground"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
