{
  "name": "@yedincoder/ngbuild",
  "version": "1.0.2",
  "description": "Modern frontend development and build tool",
  "type": "module",
  "bin": {
    "ngbuild": "bin/ngbuild.js"
  },
  "files": [
    "bin/",
    "dist/",
    "assets/"
  ],
  "scripts": {
    "dev": "npm run compile && node bin/ngbuild.js dev",
    "compile": "tsc",
